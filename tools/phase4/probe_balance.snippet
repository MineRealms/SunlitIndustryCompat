var server=net.minecraftforge.server.ServerLifecycleHooks.getCurrentServer();
if(server==null)return "NO_SERVER";
java.util.concurrent.Callable<String> task=()->{
 var ps=server.m_6846_().m_11314_();
 if(ps.isEmpty())return "NO_PLAYER";
 var p=ps.get(0);
 var C=Class.forName("com.society.sunlitmarket.currency.Currency");
 var W=Class.forName("com.society.sunlitmarket.wallet.Wallet");
 int bal=(int)C.getMethod("balance",net.minecraft.world.entity.player.Player.class).invoke(null,p);
 int cash=(int)C.getMethod("cashBalance",net.minecraft.world.entity.player.Player.class).invoke(null,p);
 int coin=(int)C.getMethod("coinBalance",net.minecraft.world.entity.player.Player.class).invoke(null,p);
 long wal=(long)W.getMethod("balance",net.minecraft.world.entity.player.Player.class).invoke(null,p);
 boolean en=(boolean)W.getMethod("enabled").invoke(null);
 return "name="+p.m_7755_().getString()+" balance="+bal+" cashBalance="+cash+" coinBalance="+coin+" wallet="+wal+" walletEnabled="+en;
};
if(server.m_18695_())return task.call();
var f=new java.util.concurrent.CompletableFuture<String>();
server.execute(()->{try{f.complete(task.call());}catch(Throwable t){f.completeExceptionally(t);}});
return f.get(120,java.util.concurrent.TimeUnit.SECONDS);
