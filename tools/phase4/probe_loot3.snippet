var server=net.minecraftforge.server.ServerLifecycleHooks.getCurrentServer();
if(server==null)return "NO_SERVER";
java.util.concurrent.Callable<String> task=()->{
 var level=server.m_129785_().iterator().next();
 var dir=java.nio.file.Paths.get("kubejs/data/me/loot_tables/blocks");
 var names=new java.util.ArrayList<String>();
 try(var s=java.nio.file.Files.list(dir)){
  s.filter(p->p.toString().endsWith(".json")).forEach(p->{
   var n=p.getFileName().toString(); names.add(n.substring(0,n.length()-5));
  });
 }
 java.util.Collections.sort(names);
 var pick=new java.util.ArrayList<String>();
 int step=Math.max(1,names.size()/24);
 for(int i=0;i<names.size()&&pick.size()<24;i+=step) pick.add(names.get(i));
 int ok=0, empty=0, missing=0;
 var emptyIds=new com.google.gson.JsonArray();
 for(var n: pick){
  var rl=new net.minecraft.resources.ResourceLocation("me",n);
  var block=net.minecraftforge.registries.ForgeRegistries.BLOCKS.getValue(rl);
  if(block==null){ missing++; continue; }
  var state=block.m_49966_();
  var builder=new net.minecraft.world.level.storage.loot.LootParams.Builder(level)
   .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.ORIGIN, new net.minecraft.world.phys.Vec3(0,100,0))
   .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.TOOL, new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.DIAMOND_PICKAXE))
   .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.BLOCK_STATE, state);
  java.lang.reflect.Method m=null;
  for(var mm: state.getClass().getMethods()){
   if(mm.getParameterCount()==1 && mm.getParameterTypes()[0].getSimpleName().equals("Builder")
      && java.util.List.class.isAssignableFrom(mm.getReturnType())){ m=mm; break; }
  }
  if(m==null){ missing++; continue; }
  var drops=(java.util.List)m.invoke(state, builder);
  if(drops.isEmpty()){ empty++; if(emptyIds.size()<8) emptyIds.add(n); } else ok++;
 }
 return "tables="+names.size()+" | sampled="+pick.size()+" | dropOk="+ok+" | empty="+empty+" | unavailable="+missing+" | emptyIds="+emptyIds;
};
if(server.m_18695_())return task.call();
var f=new java.util.concurrent.CompletableFuture<String>();
server.execute(()->{try{f.complete(task.call());}catch(Throwable t){f.completeExceptionally(t);}});
return f.get(180,java.util.concurrent.TimeUnit.SECONDS);
