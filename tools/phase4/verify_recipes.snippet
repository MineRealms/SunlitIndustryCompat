var server=net.minecraftforge.server.ServerLifecycleHooks.getCurrentServer();
if(server==null)return "NO_SERVER";
java.util.concurrent.Callable<String> task=()->{
 var rm=server.m_129894_();
 var all=new java.util.ArrayList<com.gregtechceu.gtceu.api.recipe.GTRecipe>();
 for(var r: rm.m_44051_()) if(r instanceof com.gregtechceu.gtceu.api.recipe.GTRecipe g) all.add(g);
 var ids=new java.util.HashSet<String>();
 var kjsIds=new java.util.ArrayList<String>();
 for(var g: all){var id=g.id.toString(); ids.add(id); if(id.contains(":kjs/")) kjsIds.add(id);}

 var shouldGone=new String[]{
  "gcyr:chemical_reactor/potassium_hydroxide",
  "gcyr:large_chemical_reactor/potassium_hydroxide",
  "gtceu:bender/dense_lanthanum",
  "gtceu:extractor/potassium_pyrosulfate_dust",
  "pollution:magic_chemical_reactor/magic_chemical/paradox_matter"
 };
 var stillThere=new com.google.gson.JsonArray();
 for(var s: shouldGone) if(ids.contains(s)) stillThere.add(s);

 int compounds=0;
 for(var g: all) if(g.id.toString().contains("compound_aspect/compound/")) compounds++;

 var pearl=new com.google.gson.JsonArray();
 for(var g: all){var id=g.id.toString(); if(id.contains("pearl")||id.contains("paradox_matter")) pearl.add(id);}

 var samp=new com.google.gson.JsonArray();
 for(int i=0;i<kjsIds.size()&&i<5;i++) samp.add(kjsIds.get(i));

 return "gt="+all.size()
  +" | kjs="+kjsIds.size()
  +" | compounds="+compounds
  +" | shouldBeGoneStillPresent="+stillThere
  +" | pearlRoutes="+pearl
  +" | sample="+samp;
};
if(server.m_18695_())return task.call();
var f=new java.util.concurrent.CompletableFuture<String>();
server.execute(()->{try{f.complete(task.call());}catch(Throwable t){f.completeExceptionally(t);}});
return f.get(180,java.util.concurrent.TimeUnit.SECONDS);
